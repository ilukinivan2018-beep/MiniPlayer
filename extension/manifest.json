{
  "manifest_version": 3,
  "name": "Видео на второй экран",
  "version": "1.0.0",
  "description": "Правый клик по видео — и оно во весь экран на втором мониторе (например, телефоне через spacedesk). Esc — обратно в браузер.",
  "permissions": ["contextMenus", "scripting", "storage", "system.display"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Видео на второй экран (Alt+Shift+V)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "commands": {
    "toggle-video": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Вывести видео на второй экран / вернуть обратно"
    }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
